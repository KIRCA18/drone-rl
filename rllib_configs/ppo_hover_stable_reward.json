{
  "name": "ppo_hover_stable_reward",
  "algorithm": "PPO",
  "framework": "torch",
  "api_stack": {
    "enable_rl_module_and_learner": false,
    "enable_env_runner_and_connector_v2": false
  },
  "stop_metric": "num_env_steps_sampled_lifetime",
  "stop": {
    "timesteps_total": 500000
  },
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "checkpoint_frequency": 20,
  "env_config": {
    "scenario": "baseline",
    "obs": "kin",
    "act": "one_d_rpm",
    "gui": false,
    "observation_noise_std": 0.0,
    "reward": {
      "mode": "stable_hover"
    }
  },
  "env_runners": {
    "num_env_runners": 0,
    "num_envs_per_env_runner": 1,
    "rollout_fragment_length": 256
  },
  "reporting": {
    "min_sample_timesteps_per_iteration": 4000,
    "min_time_s_per_iteration": 0
  },
  "evaluation": {
    "evaluation_interval": 5,
    "evaluation_duration": 5,
    "evaluation_duration_unit": "episodes",
    "evaluation_config": {
      "explore": false
    }
  },
  "model": {
    "fcnet_hiddens": [
      256,
      256
    ],
    "fcnet_activation": "relu"
  },
  "training": {
    "lr": 0.0003,
    "gamma": 0.99,
    "lambda_": 0.95,
    "clip_param": 0.2,
    "entropy_coeff": 0.0,
    "vf_loss_coeff": 1.0,
    "train_batch_size": 4000,
    "minibatch_size": 128,
    "num_epochs": 10
  }
}
